{
  "name": "odyssey-drifter-graybox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:performance": "playwright test --grep @performance",
    "audit:assets": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/three": "0.180.0",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.4"
  }
}
