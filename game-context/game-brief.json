{
  "$schema": "../schemas/game-brief.schema.json",
  "id": "brief-lightweight-web3d-v1",
  "version": 1,
  "language": "zh-CN",
  "status": "draft",
  "frozen": false,
  "audience": "熟悉桌面网页和键鼠操作、希望在数分钟内获得完整体验的玩家",
  "experiencePromise": "在单一空间中快速理解一个动作，并通过逐步强化的反馈完成一轮有起伏的短体验。",
  "sessionMinutes": {"min": 3, "max": 5},
  "coreVerb": null,
  "scope": {
    "sceneCount": 1,
    "coreMechanicCount": 1,
    "input": ["keyboard", "mouse"],
    "target": "Chrome desktop 1920x1080",
    "assetStrategy": "procedural-first",
    "delivery": "static-web"
  },
  "constraints": [
    "主题必须由人工在三个概念中选择",
    "无后端、运行时 AI、联网依赖或复杂物理",
    "正式视觉生产必须晚于 Fun Lock",
    "不得因框架实现提前写死世界观"
  ],
  "outOfScope": ["mobile", "multiplayer", "accounts", "persistent-save", "backend-services", "public-hosting", "blender-pipeline", "ai-gltf-pipeline"],
  "successCriteria": [
    "新玩家 30 秒内理解目标",
    "完整单局可在 5 分钟内结束",
    "具备暂停、重开、成功和失败状态",
    "质量总分至少 85，任一类别至少 75，且无 P0/P1",
    "标准路径中位 FPS 至少 55，且无持续 1 秒以上低于 45 FPS"
  ],
  "freezeRequires": "human_gate1_approval"
}
