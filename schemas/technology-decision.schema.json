{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechnologyDecision",
  "type": "object",
  "required": ["gameId", "status", "requirements", "candidates", "spikes", "selected", "humanApproval", "locked"],
  "properties": {
    "gameId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"enum": ["not_started", "evaluating", "awaiting_human_approval", "locked", "reopened"]},
    "requirements": {
      "type": "object",
      "required": ["hard", "preferences", "unknowns"],
      "properties": {
        "hard": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "preferences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "unknowns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "candidates": {"type": "array", "maxItems": 3, "items": {"type": "object"}},
    "spikes": {"type": "array", "items": {"type": "object"}},
    "selected": {"type": ["string", "null"]},
    "humanApproval": {"type": ["object", "null"]},
    "locked": {"type": "boolean"},
    "verificationCommands": {
      "type": "object",
      "properties": {
        "dev": {"type": ["string", "null"]},
        "build": {"type": ["string", "null"]},
        "test": {"type": ["string", "null"]},
        "quality": {"type": ["string", "null"]}
      }
    }
  }
}
