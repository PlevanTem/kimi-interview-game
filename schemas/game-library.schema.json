{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameLibrary",
  "type": "object",
  "required": ["version", "updatedAt", "activeGameId", "productionPaused", "games"],
  "properties": {
    "version": {"type": "string"},
    "updatedAt": {"type": "string"},
    "activeGameId": {"type": ["string", "null"]},
    "productionPaused": {"type": "boolean"},
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "path", "manifest"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["idea", "concept", "graybox", "visual", "integrated", "released", "archived"]},
          "path": {"type": "string"},
          "manifest": {"type": "string"}
        }
      }
    }
  }
}
